# DocuMind Environment Configuration Template
# Copy this file to .env and insert your real credentials.

# LLM Inference Provider (Groq Cloud API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-120b

# Optional Pinecone Vector Database (falls back to embedded memory store if unset)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=documind

# Embedding Model Identifier
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
